# Platform PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=platform
DB_HOST=platform-db
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# AI Provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# WUZAPI
WUZAPI_BASE_URL=http://wuzapi:8080
WUZAPI_ADMIN_TOKEN=

# DF Holding Database (Used by db-writer)
DF_DATABASE_URL=

# App Settings
ENV=local
LOG_LEVEL=INFO
