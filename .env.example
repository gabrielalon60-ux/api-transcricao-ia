# Development template only. Never store staging/production values here.
APP_ENV=development
LOG_LEVEL=INFO
RELEASE_IMAGE=registry.example.invalid/api-transcricao@sha256:<64-hex-digest>
POSTGRES_IMAGE=postgres@sha256:<64-hex-digest>
WUZAPI_IMAGE=registry.example.invalid/wuzapi@sha256:<64-hex-digest>
RELEASE_HOST=example.invalid
EDGE_NETWORK=<existing-edge-network>
DB_USER=platform_app
DB_PASSWORD=<secret-store-reference>
DB_NAME=platform
DATABASE_URL=postgresql://platform_app:<secret>@platform-db:5432/platform?sslmode=verify-full
API_KEY_HASH_SECRET=<secret-store-reference>
WUZAPI_WEBHOOK_SECRET=<secret-store-reference>
REGISTRATION_SECRET_PEPPER=<secret-store-reference>
LOG_PII_HASH_KEY=<secret-store-reference>
ORCHESTRATOR_TO_BOT_TOKEN=<secret-store-reference>
BOT_TO_TRANSCRIPTION_TOKEN=<secret-store-reference>
DB_WRITER_INTERNAL_TOKEN=<secret-store-reference>
WUZAPI_TOKEN=<secret-store-reference>
GEMINI_API_KEY=<secret-store-reference>
GEMINI_MODEL=gemini-3.1-flash-lite
WUZAPI_BASE_URL=http://wuzapi:8080
WUZAPI_ADMIN_TOKEN=<secret-store-reference>
BOT_DF_URL=http://bot-df:8003
TRANSCRIPTION_URL=http://transcription:8001
DB_WRITER_URL=http://db-writer:8004
DF_DATABASE_URL=postgresql://writer:<secret>@df-db.invalid:5432/df?sslmode=verify-full
DF_HOLDING_IDENTIFIERS=<secret-store-reference>
REGISTRATION_MAX_FAILED_ATTEMPTS=5
REGISTRATION_FAILURE_WINDOW_SECONDS=3600
REGISTRATION_BLOCK_SECONDS=86400
MAX_CONVERSATION_PENDING_ITEMS=10
MAX_ORGANIZATION_OUTSTANDING_ITEMS=100
MAX_ORGANIZATION_ACTIVE_ITEMS=20
MAX_PROVIDER_CONCURRENT_CALLS=2
PROVIDER_CAPACITY_ACQUIRE_TIMEOUT_SECONDS=2
